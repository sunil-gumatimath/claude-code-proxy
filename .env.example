# claude-code-proxy environment variables
# Copy this file to .env and fill in your values
# Never commit .env — it is gitignored
#
# Every setting below is optional unless marked otherwise. With just a Kilo key
# the proxy runs the whole free tier. See README.md "Settings" for the full
# reference and SECURITY.md for the cost-control model.

# ── Upstream credentials ─────────────────────────────────────────────────────

# Your Kilo Code API key (get it from https://kilo.ai)
# Uncomment and fill in. Leaving this commented means the proxy expects the
# client to send x-api-key / Authorization instead.
# KILO_API_KEY=kilo_your-real-key-here

# QwenCloud / DashScope (Alibaba) API key — https://home.qwencloud.com/api-keys
# Intl endpoint: https://dashscope-intl.aliyuncs.com  (OpenAI-compatible: /compatible-mode/v1)
# NOTE: Qwen has no free model tier. New users get a promotional 70M-token quota,
# after which usage is billed per token. With FREE_MODELS_ONLY=true (the default)
# you must opt models in explicitly via ALLOWED_MODELS below.
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=sk-your-dashscope-key-here   # alias for QWEN_API_KEY
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Shared secret clients must present. Set this whenever the proxy is reachable
# from another machine: POST /v1/messages is NOT loopback-restricted, so without
# a key anyone who can reach the port can spend your upstream key.
# With this set, configure Claude Code's ANTHROPIC_AUTH_TOKEN to the same value.
# PROXY_API_KEY=choose-a-long-random-secret

# Upstream OpenAI-compatible base URL
# KILO_BASE_URL=https://api.kilo.ai/api/gateway

# ── Network ──────────────────────────────────────────────────────────────────

# Bind address (default: 127.0.0.1 = localhost only)
# Use 0.0.0.0 only inside Docker / on a trusted network. The proxy prints a
# warning at startup for any non-loopback bind.
# PROXY_HOST=127.0.0.1

# Local proxy port
# PROXY_PORT=4181

# Model name prefix for the gateway. Applied at the wire boundary only; the
# allowlist is checked against the unprefixed id, so this can never widen what
# a client is allowed to reach.
# MODEL_PREFIX=anthropic/

# ── Model routing ────────────────────────────────────────────────────────────

# Primary: Space Bunny Alpha — $0, 1M ctx, native image/video, adjustable
# reasoning effort, ~1.2s.
# Free tier verified against the live Kilo catalog:
#   curl -s https://api.kilo.ai/api/gateway/models | grep -o '"id":"[^"]*:free"'
# DEFAULT_MODEL=kilo/stealth/space-bunny-alpha

# Tried in order after a temporary upstream failure (429/402/403/404/5xx, timeout)
# FALLBACK_MODELS=kilo/nvidia/nemotron-3-ultra-550b-a55b:free,kilo/cohere/north-mini-code:free,kilo/stepfun/step-3.7-flash:free,kilo/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,kilo/kilo-auto/free

# Vision-capable model used for image requests when SMART_ROUTING is on.
# The primary handles vision natively, so it is also the default here.
# VISION_MODEL=kilo/stealth/space-bunny-alpha

# Explicit approval list for provider-qualified models.
# Defaults to every model marked free in src/providers.ts — edit BOTH that table
# and this list when Kilo's free tier rotates. A retired entry is harmless (it
# 404s and fails over) but noisy in /v1/models.
# ALLOWED_MODELS=kilo/stealth/space-bunny-alpha,kilo/poolside/laguna-s-2.1:free,kilo/stepfun/step-3.7-flash:free
# ALLOWED_MODELS=kilo/stealth/space-bunny-alpha,qwen/qwen3.7-max,qwen/qwen3-coder-plus
#
# Set to false to skip the free-tier check (paid models still need to be listed
# above unless you also clear ALLOWED_MODELS). An unrecognised value keeps the
# secure default of true.
# FREE_MODELS_ONLY=true

# Route bare `claude-*` model names to free Kilo models. Comma-separated
# pattern=model entries; * is supported in patterns. Patterns only apply to
# bare `claude-*` names — a provider-qualified id is never rewritten.
# MODEL_ALIASES=*haiku*=kilo/stealth/space-bunny-alpha,*sonnet*=kilo/stealth/space-bunny-alpha,*opus*=kilo/stealth/space-bunny-alpha
# SMART_ROUTING=true

# Force upstream reasoning effort: low|medium|high|xhigh|max|no_think.
# Empty (default) derives it from Claude Code's thinking budget. A model with a
# restricted vocabulary (e.g. Tencent Hy3) has the request clamped to the
# strongest effort it actually accepts, rather than being sent a 400.
# REASONING_EFFORT=high

# ── Timeouts and capacity ────────────────────────────────────────────────────

# Upstream fetch timeout in milliseconds (default: 120000). Used three ways:
# the header deadline, the per-read deadline on a streaming body, and the
# deadline on a non-streaming response body — so a stalled upstream always
# releases its concurrency slot instead of pinning it.
# UPSTREAM_TIMEOUT_MS=120000

# Max request body size in bytes (default: 20MB). Larger bodies get 413.
# Also bounds a single SSE line or frame in an upstream response.
# MAX_BODY_BYTES=20971520

# Capacity protection plus per-model cooldown after 429/402/403/404/5xx failures.
# MAX_QUEUED_REQUESTS=0 disables queueing so a saturated proxy fails fast with 429.
# MAX_CONCURRENT_REQUESTS=4
# MAX_QUEUED_REQUESTS=20
# MODEL_COOLDOWN_MS=30000

# ── TLS ──────────────────────────────────────────────────────────────────────

# Keep TLS certificate verification enabled. Set to false only for a trusted
# corporate proxy / local HTTPS inspection certificate that Bun cannot verify.
# UPSTREAM_TLS_REJECT_UNAUTHORIZED=false

# Preferred solution for a corporate HTTPS-inspection certificate: point to its
# PEM file and leave verification enabled.
# UPSTREAM_CA_FILE=C:\\certs\\corporate-root-ca.pem

# ── Observability ────────────────────────────────────────────────────────────

# Verbose debug logging with redaction (default: false)
# DEBUG=true

# Comma-separated browser origins permitted for CORS. Browser access is
# disabled by default; Claude Code does not need this.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
