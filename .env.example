# claude-code-proxy environment variables
# Copy this file to .env and fill in your values
# Never commit .env — it is gitignored
#
# Every setting below is optional unless marked otherwise. With just a Kilo key
# the proxy runs the whole free tier. See README.md "Settings" for the full
# reference and SECURITY.md for the cost-control model.

# ── Upstream credentials ─────────────────────────────────────────────────────

# Your Kilo Code API key (get it from https://kilo.ai)
# Uncomment and fill in. Leaving this commented means the proxy expects the
# client to send x-api-key / Authorization instead.
# KILO_API_KEY=kilo_your-real-key-here

# QwenCloud / DashScope (Alibaba) API key — https://home.qwencloud.com/api-keys
# Intl endpoint: https://dashscope-intl.aliyuncs.com  (OpenAI-compatible: /compatible-mode/v1)
# NOTE: Qwen has no free model tier. New users get a promotional 70M-token quota,
# after which usage is billed per token. With FREE_MODELS_ONLY=true (the default)
# you must opt models in explicitly via ALLOWED_MODELS below.
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=sk-your-dashscope-key-here   # alias for QWEN_API_KEY
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Shared secret clients must present. Set this whenever the proxy is reachable
# from another machine. The proxy refuses a non-loopback bind without this key
# (fail-fast) unless you explicitly set ALLOW_UNAUTHENTICATED_REMOTE=true.
# With this set, configure Claude Code's ANTHROPIC_AUTH_TOKEN to the same value.
# PROXY_API_KEY=choose-a-long-random-secret

# Upstream OpenAI-compatible base URL
# KILO_BASE_URL=https://api.kilo.ai/api/gateway

# ── Network ──────────────────────────────────────────────────────────────────

# Bind address (default: 127.0.0.1 = localhost only)
# A non-loopback bind without PROXY_API_KEY is refused at startup (fail-fast),
# because POST /v1/messages is not loopback-restricted. Set PROXY_API_KEY, or
# — only on a trusted network where you accept the risk — opt in explicitly:
# ALLOW_UNAUTHENTICATED_REMOTE=true
# PROXY_HOST=127.0.0.1

# Local proxy port
# PROXY_PORT=4181

# Model name prefix for the gateway. Applied at the wire boundary only; the
# allowlist is checked against the unprefixed id, so this can never widen what
# a client is allowed to reach.
# MODEL_PREFIX=anthropic/

# ── Model routing ────────────────────────────────────────────────────────────

# Primary: NVIDIA Nemotron 3.5 Super VL — $0 multimodal coding model, 1M ctx,
# function calling, up to 131K output; Kilo's #6 ranked Code agent.
# Free tier verified against the live Kilo catalog (2026-11-11) using the
# gateway's `isFree` flag. Not every free model has "free" in its id (e.g.
# stealth/alpha), so read the flag rather than the name:
#   curl -s https://api.kilo.ai/api/gateway/models
# DEFAULT_MODEL=kilo/nvidia/nemotron-3.5-super-vl:free

# Everything except DEFAULT_MODEL, tried in order after a temporary upstream
# failure (429/402/403/404/5xx, timeout). The primary is not repeated here.
# NOTE: inkling-2-small went paid during 2026-11 (it now bills per token), so
# it is deliberately absent from this chain. Re-check the catalog's `isFree`
# flag when a model starts 404ing or 429ing.
# FALLBACK_MODELS=kilo/baidu/ernie-5.5-flash-preview:free,kilo/stealth/glyph-cluster,kilo/reflection/beam-free,kilo/particle-ai/particle-1:free,kilo/nvidia/nemotron-3-ultra-550b-a55b:free,kilo/nvidia/nemotron-3.5-lightning:free,kilo/cohere/north-mini-code:free,kilo/dots-studio/dots-3-note-preview:free,kilo/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,kilo/liquid/lfm-3-1.7b:free,kilo/openrouter/free,kilo/kilo-auto/free

# Vision-capable model used for image requests when SMART_ROUTING is on.
# The default primary is already multimodal, so this only matters when you
# point DEFAULT_MODEL at a text-only model.
# VISION_MODEL=kilo/nvidia/nemotron-3.5-super-vl:free

# Explicit approval list for provider-qualified models.
# Defaults to every model marked free in src/providers.ts — edit that table
# when Kilo's $0 tier rotates (the default allowlist follows it). A retired
# entry is harmless (it 404s and fails over) but noisy in /v1/models.
# ALLOWED_MODELS=kilo/nvidia/nemotron-3.5-super-vl:free,kilo/baidu/ernie-5.5-flash-preview:free,kilo/stealth/glyph-cluster
# ALLOWED_MODELS=kilo/nvidia/nemotron-3.5-super-vl:free,qwen/qwen3.7-max,qwen/qwen3-coder-plus
#
# Set to false to skip the free-tier check (paid models still need to be listed
# above unless you also clear ALLOWED_MODELS). An unrecognised value keeps the
# secure default of true.
# FREE_MODELS_ONLY=true

# Route bare `claude-*` model names to free Kilo models. Comma-separated
# pattern=model entries; * is supported in patterns. Patterns only apply to
# bare `claude-*` names — a provider-qualified id is never rewritten.
# MODEL_ALIASES=*haiku*=kilo/nvidia/nemotron-3.5-lightning:free,*sonnet*=kilo/nvidia/nemotron-3.5-super-vl:free,*opus*=kilo/nvidia/nemotron-3-ultra-550b-a55b:free
# Optional paid Anthropic models, only if your Kilo account exposes these exact
# slugs. These require FREE_MODELS_ONLY=false and explicit ALLOWED_MODELS entries;
# verify the catalog and billing before enabling them.
# MODEL_ALIASES=*haiku*=kilo/anthropic/claude-haiku-4.5,*sonnet*=kilo/anthropic/claude-sonnet-4.6,*opus*=kilo/anthropic/claude-opus-4.7
# SMART_ROUTING=true

# Force upstream reasoning effort: low|medium|high|xhigh|max|no_think.
# Empty (default) derives it from Claude Code's thinking budget. A model with a
# restricted vocabulary (e.g. Tencent Hy3) has the request clamped to the
# strongest effort it actually accepts, rather than being sent a 400.
# REASONING_EFFORT=medium

# ── Timeouts and capacity ────────────────────────────────────────────────────

# Upstream fetch timeout in milliseconds (default: 120000). Used three ways:
# the header deadline, the per-read deadline on a streaming body, and the
# deadline on a non-streaming response body — so a stalled upstream always
# releases its concurrency slot instead of pinning it.
# Reading the *client's* request body has its own fixed 120000ms per-chunk
# deadline; raising this setting does not extend it.
# UPSTREAM_TIMEOUT_MS=120000
# For slow reasoning / large-context models, raise deliberately (35 minutes):
# UPSTREAM_TIMEOUT_MS=2100000

# Max request body size in bytes (default: 20MB). Larger bodies get 413.
# Also bounds a single SSE line or frame in an upstream response.
# MAX_BODY_BYTES=20971520

# Capacity protection plus per-model cooldown after 429/402/403/404/5xx failures.
# MAX_QUEUED_REQUESTS=0 disables queueing so a saturated proxy fails fast with 429.
# MAX_CONCURRENT_REQUESTS=4
# MAX_QUEUED_REQUESTS=20
# MODEL_COOLDOWN_MS=30000

# ── TLS ──────────────────────────────────────────────────────────────────────

# Keep TLS certificate verification enabled. Set to false only for a trusted
# corporate proxy / local HTTPS inspection certificate that Bun cannot verify.
# UPSTREAM_TLS_REJECT_UNAUTHORIZED=false

# Preferred solution for a corporate HTTPS-inspection certificate: point to its
# PEM file and leave verification enabled.
# UPSTREAM_CA_FILE=C:\\certs\\corporate-root-ca.pem

# ── Observability ────────────────────────────────────────────────────────────

# Verbose debug logging with redaction (default: false)
# DEBUG=true

# Wide events (evlog): one record per completed turn — request model, routed
# model, tokens, latency, outcome. Two independent switches, both off by default.
#
# EVLOG_DRAIN=file writes NDJSON for agents and jq; console output is unchanged
# because the logger runs silent and only owns the file drain.
# EVLOG_DRAIN=file
# EVLOG_DIR=.evlog/logs
# EVLOG_MAX_FILES=14
#
# EVLOG_PRETTY=true renders the same event as a styled block in the terminal,
# alongside the existing log lines (not instead of them).
# EVLOG_PRETTY=true

# Comma-separated browser origins permitted for CORS. Browser access is
# disabled by default; Claude Code does not need this.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
