# Claude Code Proxy Configuration for Auto Mode
# Copy from .env.example and fill in your values

# ── Upstream credentials ─────────────────────────────────────────────────────
# Your Kilo Code API key (get it from https://kilo.ai)
# Without this, the proxy runs in local-adapter mode (no upstream calls)
KILO_API_KEY=your-kilo-api-key-here

# QwenCloud / DashScope (Alibaba) API key — optional
# QWEN_API_KEY=sk-your-qwen-key-here

# ── Network ──────────────────────────────────────────────────────────────────
# Bind address (default: 127.0.0.1 = localhost only)
PROXY_HOST=127.0.0.1

# Local proxy port
PROXY_PORT=4181

# ── Model routing ────────────────────────────────────────────────────────────
# Primary free model from Kilo's catalog
DEFAULT_MODEL=kilo/nvidia/nemotron-3.5-super-vl:free

# Fallback chain (tried in order after primary fails)
FALLBACK_MODELS=kilo/baidu/ernie-5.5-flash-preview:free,kilo/stealth/glyph-cluster,kilo/thinkingmachines/inkling-2-small:free

# Explicit approval list - defaults to all free models from CAPABILITIES table
# With FREE_MODELS_ONLY=true (default), only listed models are allowed
ALLOWED_MODELS=kilo/nvidia/nemotron-3.5-super-vl:free,kilo/baidu/ernie-5.5-flash-preview:free,kilo/stealth/glyph-cluster,kilo/thinkingmachines/inkling-2-small:free

# Free models only (default: true) — reject paid models not in ALLOWED_MODELS
FREE_MODELS_ONLY=true

# ── Capacity ─────────────────────────────────────────────────────────────────
# Max concurrent upstream requests
MAX_CONCURRENT_REQUESTS=4

# Max queued requests when at capacity
MAX_QUEUED_REQUESTS=20

# Model cooldown after 429/402/403/404/5xx or timeout (ms)
MODEL_COOLDOWN_MS=30000

# ── Observability ────────────────────────────────────────────────────────────
# Enable debug logging (request/response shapes with redaction)
DEBUG=false

# Upstream fetch timeout (ms)
UPSTREAM_TIMEOUT_MS=120000

# ── TLS ──────────────────────────────────────────────────────────────────────
# Verify upstream TLS certificates (keep enabled normally)
UPSTREAM_TLS_REJECT_UNAUTHORIZED=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated browser origins permitted for CORS
# Empty = browser access disabled (Claude Code doesn't need this)
CORS_ALLOWED_ORIGINS=
