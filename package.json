{
  "name": "claude-code-proxy",
  "version": "1.0.0",
  "description": "Use Kilo Code models with Claude Code. Production-ready local proxy translating Anthropic Messages API ↔ OpenAI Chat Completions for Kilo Gateway (or any OpenAI-compatible API).",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": "TED",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunil-gumatimath/claude-code-proxy.git"
  },
  "keywords": [
    "claude-code",
    "kilo",
    "kilo-code",
    "anthropic",
    "openai",
    "proxy",
    "llm",
    "bun",
    "sse",
    "tool-use"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    ".env.example"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "bun-types": "latest",
    "typescript": "^5.7.0"
  }
}
